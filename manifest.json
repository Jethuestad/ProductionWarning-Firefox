{
    "manifest_version": 3,
    "name": "PAS Production Warning",
    "version": "2.0.0",
    "description": "Shows a colored border, warning stripes and a label on PAS production sites (eksamen, prover, elev and kandidat.udir.no).",
    "icons": {
        "16": "icons/icon.svg",
        "32": "icons/icon.svg",
        "48": "icons/icon.svg",
        "96": "icons/icon.svg",
        "128": "icons/icon.svg"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "pas-production-warning@jethuestad",
            "strict_min_version": "128.0",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.eksamen.udir.no/*",
                "*://*.prover.udir.no/*",
                "*://*.kandidat.udir.no/*",
                "*://*.elev.udir.no/*"
            ],
            "js": [
                "shared/common.js",
                "content/warning.js"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_icon": "icons/icon.svg",
        "default_title": "PAS Production Warning",
        "default_popup": "popup/popup.html"
    },
    "options_ui": {
        "page": "options/options.html",
        "open_in_tab": true
    },
    "permissions": [
        "storage"
    ]
}
